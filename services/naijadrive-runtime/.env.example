# Required infrastructure
DATABASE_URL=postgresql://naijadrive:change-me@127.0.0.1:5432/naijadrive
REDIS_URL=redis://127.0.0.1:6379
NAIJADEAL_IDENTITY_URL=https://naijadeals.com
NAIJADEAL_IDENTITY_SERVICE_TOKEN=replace-with-a-secret-shared-only-with-naijadeal

# Optional tuning
PORT=3100
NAIJADRIVE_PG_POOL_MAX=10
NAIJADRIVE_PG_STATEMENT_TIMEOUT_MS=5000
NODE_ENV=development
